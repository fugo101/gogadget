# LVGL configuration shared by the firmware and the simulator (ADR-0002).
# Firmware: appended to SDKCONFIG_DEFAULTS. Simulator: LV_BUILD_DEFCONFIG_PATH.
# Keep device-only and simulator-only options out of this file.

CONFIG_LV_COLOR_FORMAT_RGB565=y
CONFIG_LV_USE_BUILTIN_MALLOC=y
CONFIG_LV_MEM_SIZE=98304
CONFIG_LV_DEF_REFR_PERIOD=33
CONFIG_LV_OS_NONE=y

CONFIG_LV_USE_TRANSLATION=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_LOG_PRINTF=y

CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_USE_THEME_DEFAULT=y
CONFIG_LV_THEME_DEFAULT_DARK=y

# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
